    {
      "name": "3. Adăugare (POST)",
      "item": [
        {
          "name": "Adaugă un job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v7/jobs/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v7",
                "jobs",
                ""
              ]
            },
            "description": "company, cif, date, status=\"activ\" și source=\"company\" sunt setate de API din cheie.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"{{jobUrl}}\",\n  \"title\": \"Java Developer (Postman)\",\n  \"location\": [\n    \"Cluj-Napoca\"\n  ],\n  \"workmode\": \"hybrid\",\n  \"tags\": [\n    \"java\",\n    \"spring\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// url unic la fiecare rulare, refolosit de requesturile următoare",
                  "pm.collectionVariables.set(\"jobUrl\", \"https://firma-test.ro/cariere/postman-\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"1 job salvat\", () => pm.expect(pm.response.json().count).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Același url din nou → 409 already_posted_use_put",
