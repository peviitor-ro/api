            ],
            "url": {
              "raw": "{{baseUrl}}/v7/jobs/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v7",
                "jobs",
                ""
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"{{jobUrl}}\",\n  \"title\": \"Java Developer (Postman)\",\n  \"location\": \"Cluj-Napoca\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"reason already_posted_use_put\", () => pm.expect(pm.response.json().conflicts[0].reason).to.eql(\"already_posted_use_put\"));"
                ]
              }
            }
          ]
        },
